{
    "name": "pos-api",
    "version": "1.0.0",
    "description": "Multi-outlet POS API: HQ master menu, outlet inventory, sales and reports",
    "main": "app.ts",
    "scripts": {
        "dev": "nodemon",
        "build": "tsc",
        "start": "node dist/server.js",
        "prod": "yarn build && yarn start",
        "db:migrate": "node -r ts-node/register -r tsconfig-paths/register src/infra/db-cli.ts migrate",
        "db:migrate:down": "node -r ts-node/register -r tsconfig-paths/register src/infra/db-cli.ts migrate:down",
        "db:migrate:status": "node -r ts-node/register -r tsconfig-paths/register src/infra/db-cli.ts migrate:status",
        "db:seed": "node -r ts-node/register -r tsconfig-paths/register src/infra/db-cli.ts seed",
        "db:seed:down": "node -r ts-node/register -r tsconfig-paths/register src/infra/db-cli.ts seed:down",
        "db:migrate:prod": "node dist/infra/db-cli.js migrate",
        "db:seed:prod": "node dist/infra/db-cli.js seed",
        "test": "jest --forceExit --coverage --verbose --runInBand --detectOpenHandles",
        "test-unit": "jest --forceExit --coverage --verbose --runInBand --detectOpenHandles unit",
        "test-integ": "jest --forceExit --coverage --verbose --runInBand --detectOpenHandles integ",
        "test-e2e": "jest --forceExit --coverage --verbose --runInBand --detectOpenHandles e2e",
        "watch-test": "yarn test -- --watchAll",
        "lint": "tsc --noEmit && eslint \"**/*.{js,ts}\" --quiet --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "debug": "yarn build && yarn serve-debug",
        "serve-debug": "nodemon --inspect dist/server.js"
    },
    "author": "Shahabuddin Ahmed",
    "license": "MIT",
    "dependencies": {
        "body-parser": "^1.20.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.0",
        "helmet": "^8.1.0",
        "joi": "^17.13.3",
        "pg": "^8.13.1",
        "pg-hstore": "^2.3.4",
        "sequelize": "^6.37.7",
        "umzug": "^3.8.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.37.0",
        "@types/body-parser": "^1.19.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^24",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.6.0",
        "@typescript-eslint/parser": "^8.6.0",
        "eslint": "^9.37.0",
        "globals": "^14.0.0",
        "jest": "^30.2.0",
        "nodemon": "^3.1.7",
        "prettier": "3.3.3",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.6.2"
    }
}
