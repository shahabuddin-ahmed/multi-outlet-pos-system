# Copy to .env and adjust. Never commit .env.
# Used by yarn dev and by both Docker Compose files (Docker sets POSTGRES_HOST and POSTGRES_PORT itself).

# API
NODE_ENV=development
APPLICATION_SERVER_PORT=4000
APP_FORCE_SHUTDOWN_SECOND=30
# Browsers may call the API only from these origins (comma-separated): the React app
WEB_ORIGIN=http://localhost:5173,http://localhost:3000
# Per IP address, per minute
RATE_LIMIT_PER_MINUTE=600
# Number of proxies in front of the API (0 locally, 1 behind a hosting platform's load balancer)
TRUST_PROXY=0

# Business settings (printed on receipts and used for report days)
BUSINESS_TIMEZONE=Asia/Dhaka
CURRENCY=BDT
# VAT in basis points: 500 = 5%. A demo value, set your legal rate
VAT_BPS=500
COMPANY_NAME=Demo Foods Ltd.
COMPANY_TAX_NO=Tax no. (demo) 000-0000
RECEIPT_FOOTER=Thank you! Visit again.

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pos
# Used by the tests only (yarn test-integ). yarn db:migrate and the tests create the databases if missing.
POSTGRES_TEST_DB=pos_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
