# Copy to .env for development (yarn dev and docker-compose.yml).
# For a production build, copy to .env.production with the real API address.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Shows the demo accounts on the login page. It is the public password of the API's demo data
# (root README). Built into the browser code: keep empty on a real installation.
NEXT_PUBLIC_DEMO_PASSWORD=
